# naozhi sudoers policy — lets naozhi move shim/CLI PIDs into a
# `naozhi-shim-<PID>.scope` (busctl) or the naozhi-shims cgroup (tee fallback)
# so sessions survive `systemctl restart naozhi`.
#
# Install: replace `ec2-user` with the service User= from deploy/naozhi.service,
# validate with `visudo -c -f <file>` (an invalid file locks all sudo access),
# then `install -m 440 -o root -g root <file> /etc/sudoers.d/naozhi`.
# NEVER widen this to `NOPASSWD: ALL` or `NOPASSWD: /usr/bin/busctl`: the
# service user also runs the Claude CLI's Bash tool, so that would hand root
# to the agent. The argv below is pinned by
# internal/shim/manager_sudoers_argv_test.go.

Defaults!NAOZHI_BUSCTL_1, NAOZHI_BUSCTL_2, NAOZHI_TEE_CGROUP setenv

# One Cmnd_Alias per PID count (shim-only / shim+cli): each `*` matches one argv.

Cmnd_Alias NAOZHI_BUSCTL_1 = /usr/bin/busctl -n call \
	org.freedesktop.systemd1 \
	/org/freedesktop/systemd1 \
	org.freedesktop.systemd1.Manager \
	StartTransientUnit \
	"ssa(sv)a(sa(sv))" \
	naozhi-shim-[0-9]*.scope fail 2 \
	PIDs au 1 [0-9]* \
	KillMode s none 0

Cmnd_Alias NAOZHI_BUSCTL_2 = /usr/bin/busctl -n call \
	org.freedesktop.systemd1 \
	/org/freedesktop/systemd1 \
	org.freedesktop.systemd1.Manager \
	StartTransientUnit \
	"ssa(sv)a(sa(sv))" \
	naozhi-shim-[0-9]*.scope fail 2 \
	PIDs au 2 [0-9]* [0-9]* \
	KillMode s none 0

Cmnd_Alias NAOZHI_TEE_CGROUP = /usr/bin/tee /sys/fs/cgroup/naozhi-shims/cgroup.procs

ec2-user ALL=(root) NOPASSWD: NAOZHI_BUSCTL_1, NAOZHI_BUSCTL_2, NAOZHI_TEE_CGROUP
